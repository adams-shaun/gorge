#!/bin/sh
# post-merge: keep the local demo in step with main.
#
# Fires after any successful merge (including `git pull`). It refreshes the
# demo on :8080/:8081 only when main itself moved, and it does the work in
# the background: the build is a Go compile plus an npm build, and nobody
# wants 30-60s added to every merge.
#
# GORGE_NO_DEPLOY=1 opts out -- set it for agent seats, CI, or any session
# that must not take the demo's ports.
[ "${GORGE_NO_DEPLOY:-}" = "1" ] && exit 0

# Only from the main checkout on main. A linked worktree has its own
# .git FILE and a git-dir that differs from the common dir, so this also
# keeps the fleet's task worktrees from each racing to own the ports.
[ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] || exit 0
[ "$(git symbolic-ref --short -q HEAD)" = "main" ] || exit 0

root=$(git rev-parse --show-toplevel) || exit 0
log=/tmp/gorge-deploy.log

# setsid so the build outlives the hook's process group -- git reaps the
# hook as soon as it returns, and a plain background job dies with it.
#
# flock WAITS rather than gives up. It used to be flock -n, and that quietly
# lost a deploy: a merge landed while the previous deploy still held the
# lock, the hook exited 0 having already truncated the log, and the demo
# went on serving the older tree with nothing anywhere saying why. A skipped
# deploy is indistinguishable from a finished one, which is the worst
# property a deploy can have. Waiting is correct because the second deploy
# rebuilds from the working tree as it is when it starts, so the newest
# merge is what ends up served. -w bounds the wait so a wedged build cannot
# strand every later merge behind it.
setsid sh -c '
	if ! flock -w 600 9; then
		echo "deploy-demo: TIMED OUT waiting for the deploy lock — demo NOT refreshed" >&2
		exit 1
	fi
	exec make -C "$1" deploy-demo
' _ "$root" 9>/tmp/gorge-deploy.lock >"$log" 2>&1 </dev/null &

echo "post-merge: refreshing the demo in the background — tail -f $log"
exit 0
