#!/bin/sh
# Shared by pre-commit and pre-merge-commit: a change that adds, deletes or
# renames a Go file, or edits the classification itself, must leave every
# package classified in docs/site/architecture/packages.tiers.json. Without
# this, TestClassificationIsComplete only fails post-merge. Checks the working tree, which for a
# merge is the merge result.
classfile=docs/site/architecture/packages.tiers.json
changed=$(git diff --cached --name-only --diff-filter=ADR -- '*.go'; git diff --cached --name-only -- "$classfile")
[ -z "$changed" ] && exit 0
if ! command -v go >/dev/null 2>&1; then
	echo "pkgmap-check: go not on PATH; skipping the package classification check" >&2
	exit 0
fi
root=$(git rev-parse --show-toplevel) || exit 1
if ! out=$(cd "$root" && go run ./cmd/pkgmap -check 2>&1); then
	echo "$1: package classification is incomplete:" >&2
	echo "$out" >&2
	echo "$1: give each new package a tier and status in $classfile (or bypass with --no-verify)" >&2
	exit 1
fi
exit 0
