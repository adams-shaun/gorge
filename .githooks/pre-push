#!/bin/sh
# 1. A push of a branch (not main, not a mergify/ or regen/ branch) runs scripts/pr-precheck.sh on the pushed head
#    unless that exact head already passed it (the stamp pr-precheck.sh leaves in the git dir). 11-26: 9 of the 10 red
#    PRs were agent branches that skipped it. PRECHECK=0 skips it: the operator's bypass, not an agent's.
# 2. When main is pushed with RACE=1 set, run the race detector once: nobody else runs -race.
zero=0000000000000000000000000000000000000000
push_main=0
check=""
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue
	# Refuse commits carrying an AI-attribution trailer or an issue-tracker
	# reference (spelled [j]ira so this hook never matches itself). A new branch
	# scans only what origin lacks, never all of history.
	if [ "$remote_sha" = "$zero" ]; then
		bad=$(git log --format='%h %s%n%b' "$local_sha" --not --remotes=origin |
			grep -Ei '^Co-Authored-By:|Generated with .*Claude|^Ref:|[j]ira' | head -3)
	else
		bad=$(git log --format='%h %s%n%b' "$remote_sha..$local_sha" |
			grep -Ei '^Co-Authored-By:|Generated with .*Claude|^Ref:|[j]ira' | head -3)
	fi
	if [ -n "$bad" ]; then
		echo "pre-push: refusing $local_ref: attribution trailer or issue-tracker reference in pushed commits:" >&2
		echo "$bad" >&2
		echo "amend/rebase the offending commit(s), then push again" >&2
		exit 1
	fi
	[ "$remote_ref" = "refs/heads/main" ] && push_main=1
	case $remote_ref in
	refs/heads/main | refs/heads/mergify/* | refs/heads/regen/*) ;;
	refs/heads/*) check="$check $local_sha" ;;
	esac
done
if [ -n "$check" ] && [ "${PRECHECK:-1}" != 0 ]; then
	top=$(git rev-parse --show-toplevel)
	head=$(git rev-parse HEAD)
	stamp=$(git rev-parse --git-path pr-precheck-ok)
	for sha in $check; do
		# Only the checked-out head can be run here; a push of another ref is not checked.
		[ "$sha" = "$head" ] || continue
		if [ "$(cat "$stamp" 2>/dev/null)" = "$head" ]; then continue; fi
		echo "pre-push: scripts/pr-precheck.sh origin/main on $head (a few minutes; PRECHECK=0 skips)" >&2
		if ! (cd "$top" && bash scripts/pr-precheck.sh origin/main) >&2; then
			echo "pre-push: pr-precheck failed; nothing was pushed. Fix it, merge origin/main, and push again." >&2
			exit 1
		fi
	done
fi
# The per-function growth rule (cmd/funcgrowth) is not a CI step (11-26): it runs here, against origin/main, when the push
# carries Go files that differ from it. SKIP_FUNCGROWTH=1 skips it for one push.
if [ -z "$SKIP_FUNCGROWTH" ] && git rev-parse -q --verify origin/main >/dev/null 2>&1 \
	&& ! git diff --quiet origin/main -- '*.go' 2>/dev/null; then
	if ! go run ./cmd/funcgrowth -base origin/main >&2; then
		echo "pre-push: a function grew past its allowance (cmd/funcgrowth); move the new logic into a handler or helper." >&2
		echo "pre-push: SKIP_FUNCGROWTH=1 git push ... skips this check for one push." >&2
		exit 1
	fi
fi
# The race gate is OFF by default: it adds ~2 min to every push of main. Run it
# deliberately before a milestone merge with RACE=1 git push origin main.
if [ "$push_main" = 1 ] && [ -n "$RACE" ]; then
	echo "pre-push: race gate on main, one package at a time" >&2
	out=$(mktemp -t gorge-race-XXXXXX.log)
	# ONE package per invocation, and -p=1 inside each. A single `go test -race`
	# over them lets -p default to GOMAXPROCS and holds that many race binaries
	# resident at once. The race detector's shadow memory sits OUTSIDE
	# GOMEMLIMIT, so the Makefile's cap does not bound it.
	for p in ./engine/state/ ./engine/events/ ./engine/effects/ ./engine/rules/ ./engine/seat/ ./engine/replay/ ./server/host/ ./server/host/httpapi/; do
		if ! go test -race -p=1 -count=1 "$p" >>"$out" 2>&1; then
			grep -vE '^ok' "$out" | tail -60 >&2
			echo "pre-push: race gate FAILED on $p — full output kept at $out" >&2
			exit 1
		fi
	done
	rm -f "$out"
fi
exit 0
