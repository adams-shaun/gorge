# deploy/docker/.env.example: the demo container's configuration.
#
# Copy it to deploy/docker/.env (gitignored); make demo-up reads it. Every
# variable is optional; the value shown is the default, and a commented-out
# line keeps it. The gorged flag each one sets is named beside it.

# --- The listener ------------------------------------------------------------
# The host address and port nginx publishes. Loopback by default; set 0.0.0.0
# to serve other machines.
#BIND_ADDR=127.0.0.1
#HTTP_PORT=8090

# --- Volumes -------------------------------------------------------------------
# Each is a Docker named volume unless set to a host path (an absolute path
# that already exists and is writable by GORGE_UID:GORGE_GID).
# Card scripts, fetched on first start; -cards
#CARDS_DIR=gorge-cards
# Card art cache, filled from Scryfall; -art-dir
#ART_DIR=gorge-art
# Persistence for tables and draft events; -dir
#DATA_DIR=gorge-data
# Player bug reports; -feedback
#FEEDBACK_DIR=gorge-feedback
# The user the container runs as; match it to a host path's owner.
#GORGE_UID=10001
#GORGE_GID=10001

# --- Tables and bots -------------------------------------------------------------
# The same knobs, and defaults, as deploy/demo.env.example.
#TABLES=2           # -tables
#SEATS=2            # -seats
#COMMANDER_SEATS=4  # -commander-seats
#FORMATS=constructed,commander   # -format
#PACE=50ms          # -pace, the delay after every bot decision
#SEED=1             # -seed
#SPECTATOR=omniscient     # -spectator, for the bot-only tables
#VSBOT_SPECTATOR=public   # -vsbot-spectator, for play-vs-bot tables
#BOT_POLICY=bot           # -bot-policy
#COMMON_SENSE=false       # -bot-common-sense
# The bot beside a person playing alone against bots: az-closed, or off.
#PAIRED_BOT=az-closed     # -paired-bot
#PAIRED_BOT_SIMS=100      # -paired-bot-sims, per decision
#PAIRED_BOT_SEARCHES=2    # -paired-bot-searches, at once across the server
# Fill the card-art cache at start; -prewarm
#PREWARM=true
# The Go memory limit for gorged (GOMEMLIMIT).
#GOMEMLIMIT=6GiB

# --- Images --------------------------------------------------------------------------
# The image names compose builds and tags. Set GORGED_IMAGE to your registry
# namespace to push what demo-image builds.
#GORGED_IMAGE=gorge/gorged-demo
#PROXY_IMAGE=gorge/gorged-demo-proxy
#GORGED_TAG=latest
