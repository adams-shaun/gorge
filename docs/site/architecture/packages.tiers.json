{
  "tiers": [
    {
      "id": "engine",
      "title": "Engine (`engine/`): T0 card pipeline and T1 rules core",
      "intro": "The card compiler, the event-sourced state, the rules engine, the per-seat view, replay, deck parsing and the `Seat` contract. Imports nothing outside `engine/`."
    },
    {
      "id": "bots",
      "title": "Bots (`bots/`)",
      "intro": "The bot policy board, the default heuristic bot, the bots registry and the hosted bots with their inference runtime (MCTS search, net forward pass, SpellBench builtins). Imports `engine/` only."
    },
    {
      "id": "server",
      "title": "Server (`server/`)",
      "intro": "The importable reference server (`server/gorged`), the host and its HTTP API, the wire protocol, the ManaBrew and SpellBench v2 adapters, and the divergence recorder."
    },
    {
      "id": "tooling",
      "title": "Tooling (`internal/`, `testkit/`, `cli/`)",
      "intro": "Module-private ratchets and code generators (`internal/`), plus the public test support, game runner and command-line layer that outside modules may import (`testkit/`, `cli/`). Shell and Python helpers live in `scripts/` (contributor/CI); they are not Go packages."
    },
    {
      "id": "cmd",
      "title": "Commands (`cmd/`)",
      "intro": "Product and developer binaries. No package imports a command."
    }
  ],
