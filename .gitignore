bin/
# Fetched Forge corpus and the IR compiled from it. Never committed: the
# scripts are GPL-3.0 and mtgcore is Apache-2.0.
.cards/
coverage.out
coverage.html

# SDD orchestration scratch (ledger, briefs, review packages).
.superpowers/

# Per-task git worktrees for fleet execution (SDD).
.worktrees/

# Agent scratch: task briefs, reports, pi session transcripts. Written inside
# whichever worktree an agent runs in, so a `git add -A` sweeps them into the
# diff -- which is how one branch's reports reached a merge before this line
# existed. Orchestration records belong in .superpowers/, not in history.
.ds4/

# web/ (Svelte + Vite spectator client) build artefacts and tooling state.
cmd/gorged/webdist/*
!cmd/gorged/webdist/.keep
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
gorged-data/
