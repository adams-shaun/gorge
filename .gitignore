bin/
# Fetched Forge corpus and the IR compiled from it. Never committed: the
# scripts are GPL-3.0 and mtgcore is Apache-2.0.
.cards/

# Deck pools for dirac's oracle (GORGE_POOLS' default). 17Lands derivatives that
# ship as a release asset, never in git.
.pools

# Oracle-audit author packets (oraclepacket output): corpus-derived
# printed card text handed to a scenario-writing seat. Never committed.
.oracle-packets/

# Exact token script text that cmd/repro -emit-test and the fixture
# generator strip out of committed match.json files. GPL-3.0; gorge is
# Apache-2.0. Keyed by fixture id; written under cmd/repro/testdata/.tokens
# so a local checkout can still replay a fixture with its exact historical
# token scripts.
cmd/repro/testdata/.tokens/
coverage.out
coverage.html

# Local scratch.
.superpowers/

# Per-task git worktrees for fleet execution (SDD).
.worktrees/

# Agent scratch, written inside whichever worktree an agent runs in.
.ds4/

# web/ (Svelte + Vite spectator client) build artefacts and tooling state.
server/gorged/webdist/*
!server/gorged/webdist/.keep
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
gorged-data/
/feedback/
wire-found-*
__pycache__/
*.pyc

# `go build ./cmd/<x>` with no -o drops the binary at the repo root, where it is
# untracked and dirties the base checkout. That is not cosmetic: the daemon's
# landing check holds any branch touching an uncommitted base path, so one
# stray 11 MB botbench (2026-09-21) can block merges until someone notices.
# One line per command in cmd/, anchored to the root so a real package of the
# same name is unaffected.
/botbench
/deckimport
/forgec
/gcgate
/gentypes
/gorged
/keywordbench
/mtgsim
/policytrain
/policytune
/repro
/searchprobe
/searchteacher
/searchbench
/testbudget

# `make coverage` output (cmd/forgec coverage): generated card-support tables,
# published by the `card coverage` CI job, never committed.
.coverage/

# Local scratch. Never committed.
/scratch/

# MkDocs build output (mkdocs.yml site_dir) and the docs workflow's
# build-time inputs: the generated set and package tables. Never committed.
/site/
docs/site/support/_generated_sets.md
docs/site/architecture/_generated_packages.md

# The cards.IR cache's single-flight lock: a run whose test cwd is a
# command package can drop one next to the sources. Never
# committed (the cache itself lives under the gitignored .cards/).
ir-*.gob.gz.lock
